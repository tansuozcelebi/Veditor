# Copy to .env.deploy (git-ignored) for local deploys with `npm run deploy`.
# In GitHub Actions the same names are read from repository secrets / variables.
SITEGROUND_FTP_HOST=ftp.example.com
SITEGROUND_FTP_USER=deploy@example.com
SITEGROUND_FTP_PASSWORD=change-me
SITEGROUND_REMOTE_DIR=public_html
SITEGROUND_FTP_PORT=21
# true = explicit FTPS (default), false = plain FTP, implicit = implicit FTPS
SITEGROUND_FTP_SECURE=true
# Optional: public URL of the app; when set, the deploy is verified over HTTP afterwards
SITEGROUND_SITE_URL=https://example.com
# Optional: post-deploy check mode: auto (default; a wrong file fails, a bot-protection challenge only warns) | strict | warn | off
SITEGROUND_VERIFY=auto
# Optional: URL *path* (not a full URL) the app is served from when it lives in a sub-folder, e.g. /veditor/
VITE_BASE_PATH=/
