{
  "name": "veditor",
  "version": "2.0.0",
  "private": true,
  "description": "Multi-track browser video editor (React + shadcn/ui): multi-channel player, audio mixing, voice-over, transitions, text layers and export.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8080 --open",
    "start": "vite --port 8080 --open",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 8080",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "node test/smoke.test.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "playwright": "1.56.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
