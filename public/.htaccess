# Veditor – single-page app on Apache (SiteGround). Uploaded with the build by scripts/deploy-siteground.mjs.

# Client-side routing: serve real files/directories, send every other path to index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# Caching: hashed bundles are immutable, index.html must always be re-validated
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # the ffmpeg.wasm codec core is versioned with the build and never changes in place
  <FilesMatch "^ffmpeg-core\.(js|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Content Security Policy. The editor works entirely on local files, so it needs what a normal
  # page does not: blob: URLs for the media elements and the ffmpeg.wasm worker, data: URLs for the
  # thumbnails it paints from the canvas, and 'wasm-unsafe-eval' to compile the codec core. Hosting
  # panels often install a bare "default-src 'self'" that blocks all of it; this replaces it.
  # (Header set overrides a value set higher up in the server configuration.)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://static.cloudflareinsights.com; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' blob: data: https://static.cloudflareinsights.com https://unpkg.com https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# Correct MIME types for module scripts and media
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType video/webm .webm
  AddType application/wasm .wasm
  AddType audio/webm .weba
  AddType font/woff2 .woff2
</IfModule>

# Compression (SiteGround usually enables this globally; harmless if already on)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

Options -Indexes
